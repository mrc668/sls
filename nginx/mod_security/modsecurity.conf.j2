# --- Basic Configuration ---
SecRuleEngine {{ salt['pillar.get']('waf_settings:engine_mode', 'On') }}
SecRequestBodyAccess {{ salt['pillar.get']('waf_settings:secRequestBodyAccess', 'On') }}
SecRequestBodyLimit {{ salt['pillar.get']('waf_settings:limits:request_body', '13107200') }}
SecRequestBodyNoFilesLimit {{ salt['pillar.get']('waf_settings:limits:request_no_file', '131072') }}

# --- Response Body Handling ---
SecResponseBodyAccess On
SecResponseBodyLimit {{ salt['pillar.get']('waf_settings:limits:response_body', '524288') }}
SecResponseBodyLimitAction ProcessPartial
SecResponseBodyMimeType text/plain text/html text/xml application/json

# --- Filesystem & Logging ---
SecTmpDir /tmp/
SecDataDir /var/lib/nginx/modsec/
SecAuditEngine RelevantOnly
SecAuditLogRelevantStatus "^(?:5|4(?!04))"
#SecAuditLogType Serial
SecAuditLog /var/log/nginx/modsec_audit.log

# FIXED: Rocky 9 RPM path for unicode.mapping
SecUnicodeMapFile /etc/nginx/unicode.mapping 20127

# --- Dynamic Whitelisting ---
{% if salt['pillar.get']('waf_settings:exclusions') %}
{% for entry in salt['pillar.get']('waf_settings:exclusions') %}
# Exclusions for IP: {{ entry.ip }}
SecRule REMOTE_ADDR "@ipMatch {{ entry.ip }}" \
    "id:{{ loop.index + 1000 }},phase:1,pass,nolog,ctl:ruleRemoveById={{ entry.ids | join(',') }}"
{% endfor %}
{% endif %}

# --- Performance & Protection Limits ---
SecPcreMatchLimit {{ salt['pillar.get']('waf_settings:limits:pcre_match', '100000') }}
SecPcreMatchLimitRecursion {{ salt['pillar.get']('waf_settings:limits:pcre_match', '100000') }}
SecRequestBodyLimitAction Reject

# --- Active Defense / Tarpit Logic ---
# Step 1: Initialize IP collection
SecAction "id:3000,phase:1,nolog,pass,initcol:ip=%{remote_addr}"

# Step 2: The Tarpit
# If block_count > threshold, deny with the Pillar-defined status (444)
SecRule ip:block_count "@gt {{ salt['pillar.get']('waf_settings:active_defense:penalty_threshold', '1') }}" \
    "id:3001,phase:1,deny,status:{{ salt['pillar.get']('waf_settings:block_status', '444') }},nolog,msg:'Dropping known scanner'"

# Step 3: Record New Violations
# Increment the block count if Nginx issues the block status
SecRule RESPONSE_STATUS "@eq {{ salt['pillar.get']('waf_settings:block_status', '444') }}" \
    "id:3002,phase:5,nolog,setvar:ip.block_count=+1,expirevar:ip.block_count={{ salt['pillar.get']('waf_settings:active_defense:expiry_seconds', '3600') }}"

# --- OWASP Core Rule Set (Required to catch exec=/bin/bash) ---
# These paths are standard for the mod_security_crs RPM on Rocky 9
Include /etc/httpd/modsecurity.d/crs-setup.conf
Include /usr/share/mod_modsecurity_crs/rules/*.conf
